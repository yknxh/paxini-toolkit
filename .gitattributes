# Line ending rules (override each PC's git settings, e.g. the Windows default core.autocrlf=true)
# Default: text is LF in both the repository and the working tree
* text=auto eol=lf

# Test reference files (PXSR CSV, captured bytes) are never converted — they are compared byte for byte
tests/fixtures/** -text

# Only Windows batch files use CRLF
*.bat text eol=crlf
